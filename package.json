{
  "name": "twin-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Twin AI — agentic industrial digital twin platform (hackathon MVP)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "reset-demo": "rm -rf .data",
    "backend": "PYTHONPATH=. .venv/bin/uvicorn backend.main:app --port ${BACKEND_PORT:-8000}",
    "test:backend": ".venv/bin/python -m pytest backend/tests -q",
    "deploy:render": "bash scripts/deploy-render.sh"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-dialog": "1.3.0",
    "@radix-ui/react-slider": "1.6.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.0",
    "@radix-ui/react-tabs": "1.2.0",
    "@radix-ui/react-tooltip": "1.4.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.1.3",
    "@xyflow/react": "12.12.0",
    "clsx": "2.1.1",
    "hls.js": "1.7.3",
    "lucide-react": "0.577.0",
    "mqtt": "5.16.1",
    "next": "15.5.27",
    "postprocessing": "6.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "2.15.4",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.29",
    "uuid": "11.1.1"
  }
}
